---
import DefaultLayout from '@/layouts/Default.astro'
import ClimatePage from '@/pages/_vue/projection.vue'
import { getProvincesData } from '@/pages/api/listprovinces'

const { provinces, models } = getProvincesData()
---

<DefaultLayout>
  <!-- uses default from ./layouts -->
  <!-- Pass server-side data as props -->
  <ClimatePage client:visible {provinces} {models} />
  <!-- inserts ClimatePage from ./components into layout slot -->
</DefaultLayout>
